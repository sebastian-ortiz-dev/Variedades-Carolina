    "basePath": "/api/v1",
    "paths": {
        "/auth/login": {
            "post": {
                "description": "Login of the application and get the token JWT.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Login users get the JWT token",
                "parameters": [
                    {
                        "description": "Datos del usuario",
                        "name": "userdata",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/variedades_carolina_src_auth_DTOs.LoginUserEntrydata"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "ok",
                        "schema": {
                            "$ref": "#/definitions/variedades_carolina_src_auth_DTOs.LoginResponseUser"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/variedades_carolina_src_errors.HttpError"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/variedades_carolina_src_errors.HttpError"
                        }
                    }
                }
            }
        },
        "/inventory/list": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Probar handlers con grupos.",
                "tags": [
                    "Test"
                ],
                "summary": "Test handler",
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        },
        "/inventory/modify": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Probar handlers con grupos.",
                "tags": [
                    "Test"
                ],
                "summary": "Test handler",
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        }
    },
    "definitions": {
        "variedades_carolina_src_auth_DTOs.LoginResponseUser": {
            "type": "object",
            "properties": {
                "expirein": {
                    "type": "string"
                },
                "token": {
                    "type": "string"
                },
                "tokentype": {
                    "type": "string"
                },
                "user": {
                    "$ref": "#/definitions/variedades_carolina_src_auth_DTOs.Userdata"
                }
            }
        },
        "variedades_carolina_src_auth_DTOs.LoginUserEntrydata": {
            "type": "object",
            "required": [
                "email",
                "password"
            ],
            "properties": {
                "email": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            }
        },
        "variedades_carolina_src_auth_DTOs.Userdata": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "rol": {
                    "type": "string"
                }
            }
        },
        "variedades_carolina_src_errors.HttpError": {
            "type": "object",
            "properties": {
                "codigo": {
                    "type": "string"
                },
                "detail": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "Escribe 'Bearer ' seguido de tu token JWT Ejemplo: \"Bearer tokenJWT\"",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}